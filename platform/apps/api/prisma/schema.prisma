generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  traveler
  operator
  admin
}

enum CabinClass {
  business
  first
}

enum FlightProviderSource {
  duffel
  amadeus
  sabre
  travelport
  mock
}

enum EmptyLegProviderSource {
  platform_listed
  avinode
  jettly
  mock
}

enum EmptyLegStatus {
  available
  booked
  expired
  cancelled
}

enum BookingType {
  flight
  empty_leg
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  failed
}

enum PaymentStatus {
  unpaid
  authorized
  captured
  refunded
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  role      UserRole @default(traveler)
  operatorId String? @map("operator_id")
  createdAt DateTime @default(now()) @map("created_at")

  operator Operator? @relation(fields: [operatorId], references: [id])
  bookings Booking[]

  @@map("users")
}

/// A private/business jet operator that lists empty legs directly on the
/// marketplace. `stripeConnectedAccountId` is set once the operator
/// completes Stripe Connect onboarding, enabling payout on booking.
model Operator {
  id                       String   @id @default(uuid())
  name                     String
  contactEmail             String   @map("contact_email")
  contactPhone             String?  @map("contact_phone")
  certificateNumber        String?  @map("certificate_number")
  verified                 Boolean  @default(false)
  stripeConnectedAccountId String?  @map("stripe_connected_account_id")
  createdAt                DateTime @default(now()) @map("created_at")

  staff     User[]
  emptyLegs EmptyLeg[]

  @@map("operators")
}

/// A cached, priced Business/First class fare returned from a provider
/// search (Duffel/Amadeus/Sabre/Travelport/mock). Not authoritative
/// inventory — it's a short-lived snapshot a Booking can reference for
/// audit purposes; `expiresAt` mirrors the provider's own offer TTL.
model Flight {
  id             String               @id @default(uuid())
  source         FlightProviderSource
  sourceOfferId  String               @map("source_offer_id")
  cabinClass     CabinClass           @map("cabin_class")
  airline        String
  origin         String
  destination    String
  departureAt    DateTime             @map("departure_at")
  arrivalAt      DateTime             @map("arrival_at")
  rawPayload     Json                 @map("raw_payload")
  amount         Decimal
  currency       String
  seatsAvailable Int?                 @map("seats_available")
  expiresAt      DateTime             @map("expires_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  booking Booking?

  @@index([origin, destination, departureAt])
  @@map("flights")
}

/// A repositioning-flight listing with empty seats sold at a discount.
/// Either entered directly by an Operator (`source = platform_listed`,
/// `operatorId` set) or pulled from an external aggregator like Avinode
/// or Jettly (`operatorId` may be null; `operatorName`/`sourceListingId`
/// carry the vendor's own attribution).
model EmptyLeg {
  id              String                 @id @default(uuid())
  operatorId      String?                @map("operator_id")
  operatorName    String                 @map("operator_name")
  source          EmptyLegProviderSource
  sourceListingId String?                @map("source_listing_id")
  aircraftType    String                 @map("aircraft_type")
  origin          String
  destination     String
  departureAt     DateTime               @map("departure_at")
  arrivalAt       DateTime               @map("arrival_at")
  seatsAvailable  Int                    @map("seats_available")
  amount          Decimal
  currency        String
  status          EmptyLegStatus         @default(available)
  createdAt       DateTime               @default(now()) @map("created_at")

  operator Operator? @relation(fields: [operatorId], references: [id])
  booking  Booking?

  @@index([origin, destination, departureAt])
  @@index([status])
  @@map("empty_legs")
}

/// References exactly one of `flightId` / `emptyLegId`, enforced at the
/// application layer (BookingService) rather than in the schema, since
/// Prisma has no native "exactly one of" constraint.
model Booking {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  bookingType   BookingType   @map("booking_type")
  flightId      String?       @unique @map("flight_id")
  emptyLegId    String?       @unique @map("empty_leg_id")
  status        BookingStatus @default(pending_payment)
  totalAmount   Decimal       @map("total_amount")
  currency      String
  paymentStatus PaymentStatus @default(unpaid) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  flight   Flight?   @relation(fields: [flightId], references: [id])
  emptyLeg EmptyLeg? @relation(fields: [emptyLegId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id                    String        @id @default(uuid())
  bookingId             String        @map("booking_id")
  stripePaymentIntentId String        @map("stripe_payment_intent_id")
  amount                Decimal
  currency              String
  platformFeeAmount     Decimal       @map("platform_fee_amount")
  status                PaymentStatus @default(unpaid)
  createdAt             DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("payments")
}
