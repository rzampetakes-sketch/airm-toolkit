# Database & cache
DATABASE_URL="postgresql://travel:travel@localhost:5432/travel_platform"
REDIS_URL="redis://localhost:6379"

# Set true for local dev / demos before any real provider credentials
# exist — enables MockFlightProvider and MockEmptyLegProvider.
USE_MOCK_PROVIDERS=true

# Part 1: Business/First class flight search
DUFFEL_API_KEY=
# Amadeus Self-Service is decommissioned (2026-07-17). Only set these if
# you hold Enterprise-portal credentials — see api-provider-research.md.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENTERPRISE=false
# Sabre requires activation by a Sabre account rep before these work.
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=

# Part 2: Private jet empty-leg marketplace (each is one adapter — add a
# provider without touching EmptyLegsService, see empty-legs.module.ts)
AVINODE_API_KEY=
AVINODE_API_SECRET=
# Unverified public APIs — confirm with each vendor directly before relying on these.
JETTLY_API_KEY=
JETHUNTER_API_KEY=
VILLIERS_API_KEY=

# Add-ons at checkout: hotel / car rental / airport taxi (contracted
# partner TBD per docs/architecture/ARCHITECTURE.md)
PARTNER_HOTEL_API_KEY=
PARTNER_CAR_RENTAL_API_KEY=
PARTNER_TAXI_API_KEY=

# Payments (merchant of record + Stripe Connect payout to operators)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Live chat widget (apps/web) — Crisp website ID; unset disables the widget
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m
