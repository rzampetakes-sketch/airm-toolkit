# ============================================================================
# Travel Aggregator — environment configuration
#
# 1. Copy this file to ".env" in the same folder:   cp .env.example .env
# 2. Fill in the values below with your own credentials.
# 3. NEVER commit the real ".env" file — it is already listed in .gitignore.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (used by CORS).
# When the frontend is served by this same server (the default setup),
# you can leave this as-is.
CORS_ORIGIN=http://localhost:4000

# --- Amadeus Self-Service API (live flight & hotel data) --------------------
# Get free credentials at https://developers.amadeus.com
#   1. Create an account -> "My Self-Service Workspace" -> "Create new app".
#   2. Copy the "API Key" into AMADEUS_CLIENT_ID below.
#   3. Copy the "API Secret" into AMADEUS_CLIENT_SECRET below.
# The free tier runs against the TEST environment, which returns realistic,
# live-queried data but with a limited catalog of routes/hotels. Switch
# AMADEUS_HOSTNAME to "production" only after Amadeus approves your app for
# production traffic (paid tier).
AMADEUS_CLIENT_ID=your_amadeus_api_key_here
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret_here
AMADEUS_HOSTNAME=test

# --- Travelpayouts affiliate program (monetization) --------------------------
# Get your free affiliate/marker ID at https://www.travelpayouts.com
#   1. Sign up as an affiliate (free) and create a "website" project.
#   2. Your affiliate ID is shown in the dashboard as "marker" (a number,
#      e.g. 123456). Paste it below.
# This marker is automatically attached to every outbound "Book Now" link
# for flights (Aviasales) and hotels (Hotellook) so your conversions and
# commissions are tracked correctly.
TRAVELPAYOUTS_MARKER=your_travelpayouts_marker_id_here

# Optional: only needed if you later add Travelpayouts' own Data/White Label
# APIs (not required for the affiliate deep-links used in this project).
TRAVELPAYOUTS_API_TOKEN=

# --- Rate limiting ------------------------------------------------------------
# Requests allowed per IP address, per time window, to the /api/* endpoints.
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX_REQUESTS=60

# --- Corporate portal session security ---------------------------------------
# Signs the login session cookie for the B2B Corporate Portal (dashboard +
# admin panel). Generate a real random value before going live:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# --- Corporate database -------------------------------------------------------
# No setup needed: companies/users/bookings are stored in a local SQLite file
# at backend/data/corporate.db, created and demo-seeded automatically on first
# run (see src/db/database.js for the demo login credentials it prints).
# To point this at a hosted database instead (Postgres/MySQL) once you're
# ready to scale beyond a single server, see the comment at the top of
# src/db/database.js — you only need to change that one file.
